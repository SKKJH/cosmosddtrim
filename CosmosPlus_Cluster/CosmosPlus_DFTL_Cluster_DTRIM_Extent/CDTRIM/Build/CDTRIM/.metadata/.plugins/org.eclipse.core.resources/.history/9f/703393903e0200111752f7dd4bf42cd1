static inline void _safe_store_u32(UINT32* p, UINT32 v) {
    uintptr_t a = (uintptr_t)p;
    if ((a & 3u) == 0) { *p = v; }
    else {
        volatile UINT8* b = (volatile UINT8*)p;
        b[0] = (UINT8)(v      );
        b[1] = (UINT8)(v >>  8);
        b[2] = (UINT8)(v >> 16);
        b[3] = (UINT8)(v >> 24);
    }
}

