	host_write_cnt = 0;

	for (int i=0; i<USER_CLUSTERS; i++)
	{
		m_util_pages[i] = 0;
		m_util_blks[i] = 0;
		m_nTrimSize[i] = 0;

		m_wp_ch[i] = 0;
		m_wp_wy[i] = 0;
