#include "dftl_internal.h"

// [구조체 정의] ProcessSelectiveTRIM용
struct ClusterPriorityInfo {
	UINT32 nClusterID;
	INT32  nFutureUtil; // 미래 예상 유효 페이지 (낮을수록 좋음)
};

VOID
SUPER_GC_MGR::Initialize(VOID)
{
	m_nThreshold	= DFTL_GLOBAL::GetGCMgr(0,0)->m_nThreshold;
	m_nVictimVBN 	= INVALID_VBN;
	m_nTMPVictimVBN	= INVALID_VBN;
	m_nGCCnt 		= 0;
	gc_trim			= 0;
	victimVPC		= 0;
	loadCNT			= 0;
}

BOOL
SUPER_GC_MGR::IsGCRunning(VOID)
{
	if (m_nVictimVBN == INVALID_VBN)
		return 0;
	else
		return 1;
}

// [방식 1] Selective TRIM: 우선순위가 높은(효율 좋은) 클러스터의 메타 그룹부터 처리 (Load Limit 적용)
UINT32 SUPER_GC_MGR::ProcessSelectiveTRIM(VOID)
{
	DFTL_GLOBAL* pGlobal = DFTL_GLOBAL::GetInstance();
	META_MGR* pMetaMgr = DFTL_GLOBAL::GetMetaMgr();
	REQUEST_MGR* pReqMgr = DFTL_GLOBAL::GetRequestMgr();
	META_REQUEST_INFO* pMetaReqInfo = pReqMgr->GetMetaRequestInfo();

	UINT32 nCMTLoadCount = 0;
	const UINT32 CMT_LOAD_LIMIT = 30; // 최대 메타 로드 횟수 (예산)

	// 1. Cluster Priority 정렬
	ClusterPriorityInfo stClusters[USER_CLUSTERS];
	for (UINT32 i = 0; i < USER_CLUSTERS; i++) {
		TRIM_MGR* pMgr = pGlobal->GetTrimMgr(i);
		stClusters[i].nClusterID = i;
		stClusters[i].nFutureUtil = pGlobal->m_util_pages[i] - (INT32)pMgr->m_nPendingTrimPages;
	}

	// Bubble Sort
	for (UINT32 i = 0; i < USER_CLUSTERS - 1; i++) {
		for (UINT32 j = 0; j < USER_CLUSTERS - 1 - i; j++) {
			if (stClusters[j].nFutureUtil > stClusters[j+1].nFutureUtil) {
				ClusterPriorityInfo temp = stClusters[j];
				stClusters[j] = stClusters[j+1];
				stClusters[j+1] = temp;
			}
		}
	}

	// 2. 우선순위 높은 클러스터부터 처리
	for (UINT32 k = 0; k < USER_CLUSTERS; k++)
	{
		if (nCMTLoadCount >= CMT_LOAD_LIMIT) break;

		UINT32 nClusterID = stClusters[k].nClusterID;
		TRIM_MGR* pTrimMgr = pGlobal->GetTrimMgr(nClusterID);

		while (nCMTLoadCount < CMT_LOAD_LIMIT)
		{
			CMT_GROUP_NODE* pBestGroup = pTrimMgr->PopBestCMTGroup();

			if (pBestGroup == NULL) break; // 해당 클러스터에 처리할 그룹 없음

			UINT32 nMetaLPN = pBestGroup->m_nMetaLPN;
			UINT32 nBaseDataLPN = nMetaLPN * L2V_PER_META_PAGE;

			// ----------------------------------------------------------------
			// [FIX] Simple Loop Logic: 로드될 때까지 반복
			// Writeback 등으로 인해 로드 실패 시, 다시 LoadMeta를 호출하여 재시도함
			// ----------------------------------------------------------------
			while (TRUE)
			{
				// 1. LoadMeta 호출 (Hit면 즉시 리턴, Miss면 Read/Writeback 요청 생성)
				pMetaMgr->LoadMeta(nBaseDataLPN, TRIM_OPT, TRIM_OPT);

				META_REQUEST* pstRequest = NULL;

				// 2. I/O 처리 루프
				do {
					pReqMgr->_ProcessMetaRequestWaitQ();
					FIL_Run();

					pstRequest = pMetaReqInfo->GetDoneRequest();
					if (pstRequest != NULL) {
						pstRequest->Run(); // LoadDone or StoreDone
					}

					// 중간에라도 로드되었으면(Hit 포함) 루프 탈출
					if (pMetaMgr->IsMetaAvailable(nBaseDataLPN, TRIM_OPT)) {
						goto META_LOADED; // 성공 -> 탈출
					}

				} while (pstRequest != NULL); // 큐 비울 때까지

				// 여기까지 왔는데도 IsMetaAvailable이 False라면 (Writeback만 수행됨),
				// while(TRUE)에 의해 다시 위로 올라가서 LoadMeta를 재호출함.
			}

		META_LOADED:
		nCMTLoadCount++; // [중요] 실제 처리가 되었을 때만 증가
		}
	}

	if (pGlobal->m_nGlobalUsedNodeCount == 0) {
		TrimPending_Clear();
	}

	return nCMTLoadCount;
}

// [방식 2] All Pending TRIM: CMT Map을 순회하며 TRIM이 있는 '모든' 메타 페이지를 로드 (비교군)
UINT32 SUPER_GC_MGR::ProcessAllPendingTrim(VOID)
{
	DFTL_GLOBAL* pGlobal = DFTL_GLOBAL::GetInstance();
	META_MGR* pMetaMgr = DFTL_GLOBAL::GetMetaMgr();
	REQUEST_MGR* pReqMgr = DFTL_GLOBAL::GetRequestMgr();
	META_REQUEST_INFO* pMetaReqInfo = pReqMgr->GetMetaRequestInfo();

	UINT32 nProcessedMetaCount = 0;

	// 클러스터당 메타 페이지 개수 계산
	UINT32 nTotalLPN = pGlobal->GetLPNCount();
	UINT32 nLPNsPerCluster = nTotalLPN / USER_CLUSTERS;
	UINT32 nMetaPagesPerCluster = (nLPNsPerCluster + L2V_PER_META_PAGE - 1) / L2V_PER_META_PAGE;

	// 1. 모든 클러스터 순회
	for (UINT32 nCluster = 0; nCluster < USER_CLUSTERS; nCluster++)
	{
		TRIM_MGR* pTrimMgr = pGlobal->GetTrimMgr(nCluster);
		if (pTrimMgr->m_pCMTNodeMap == NULL) continue;

		// 2. 해당 클러스터의 CMT Map을 순회
		for (UINT32 i = 0; i < nMetaPagesPerCluster; i++)
		{
			CMT_GROUP_NODE* pNode = &pTrimMgr->m_pCMTNodeMap[i];

			// 3. Pending TRIM이 있는 메타 페이지만 골라서 처리
			if (pNode->m_nTotalTrim > 0)
			{
				UINT32 nMetaLPN = pNode->m_nMetaLPN; // Global Meta LPN
				UINT32 nBaseDataLPN = nMetaLPN * L2V_PER_META_PAGE;

				// ----------------------------------------------------------------
				// [FIX] Simple Loop Logic: 로드될 때까지 반복 (동일 구조)
				// ----------------------------------------------------------------
				while (TRUE)
				{
					pMetaMgr->LoadMeta(nBaseDataLPN, TRIM_OPT, TRIM_OPT);

					META_REQUEST* pstRequest = NULL;

					do {
						pReqMgr->_ProcessMetaRequestWaitQ();
						FIL_Run();

						pstRequest = pMetaReqInfo->GetDoneRequest();
						if (pstRequest != NULL) {
							pstRequest->Run();
						}

						if (pMetaMgr->IsMetaAvailable(nBaseDataLPN, TRIM_OPT)) {
							goto META_LOADED_ALL;
						}
					} while (pstRequest != NULL);

					// 로드 안 됐으면 다시 위로
				}

			META_LOADED_ALL:
			nProcessedMetaCount++;
			}
		}
	}

	if (pGlobal->m_nGlobalUsedNodeCount == 0) {
		TrimPending_Clear();
	}

	return nProcessedMetaCount;
}

UINT32
SUPER_GC_MGR::GetVictimVBN(VOID)
{
	SBINFO_MGR* pSBMgr  = DFTL_GLOBAL::GetSBInfoMgr();
	VNAND* pVNAND   	= DFTL_GLOBAL::GetVNandMgr();
	UINT32 vblk_cnt 	= DFTL_GLOBAL::GetInstance()->m_nVBlockCount;

	UINT32 best_vbn = INVALID_VBN;
	UINT32 best_vpc = pVNAND->GetVPagesPerVBlock() * (USER_CHANNELS * USER_WAYS);

	for (UINT32 vbn = 20; vbn < vblk_cnt; ++vbn)
	{
		SBINFO& sb = pSBMgr->m_pastSBInfo[vbn];

		if ((sb.IsMeta() == TRUE) || (sb.IsBad() == TRUE) || (sb.IsFree() == TRUE)) {
			continue;
		}
		UINT32 sb_vpc_total = 0;

		for (UINT32 ch = 0; ch < USER_CHANNELS; ++ch)
		{
			for (UINT32 wy = 0; wy < USER_WAYS; ++wy)
			{
				UINT32 	valid;
				VBINFO* vbi   = DFTL_GLOBAL::GetVBInfoMgr(ch, wy)->GetVBInfo(vbn);
				if (vbi->IsFree())
					valid = 0;
				else
				{
					valid = pVNAND->GetVPagesPerVBlock() - vbi->GetInvalidLPNCount();
				}
				sb_vpc_total += valid;
			}
		}

		if (sb_vpc_total < best_vpc) {
			best_vpc = sb_vpc_total;
			best_vbn = vbn;
		}
	}
	victimVPC = best_vpc;

	return best_vbn;
}

BOOL
SUPER_GC_MGR::CheckAndStartGC()
{
	if (DFTL_GLOBAL::GetInstance()->SB_INIT_FLAG == FALSE)
		return 0;

	if (IsGCRunning() == TRUE)
	{
		return 0;
	}

	DFTL_GLOBAL* pstGlobal = DFTL_GLOBAL::GetInstance();
	BOOL bTrimTrigger = (TrimPending_IsOn());
	UINT32 nFreeBlock = pstGlobal->GetSBInfoMgr()->m_nFreeCount;
	BOOL bBlockGCTrigger = (nFreeBlock <= m_nThreshold);

	if (!bBlockGCTrigger)
	{
		return 0;
	}

	UINT32 prevVPC = victimVPC;
	UINT32 processed = 0;
	UINT32 CandVBN;

	if (bTrimTrigger)
	{
		// =================================================================
		// [TRIM 처리 정책 선택]
		// Selective (최적화) vs AllPending (전수조사) 중 하나를 선택하세요.
		// =================================================================

		// 1. Selective TRIM (효율 중심, Load 제한 있음)
		processed = ProcessSelectiveTRIM();

		// 2. All Pending TRIM (완전 처리 중심, 모든 메타 로드)
//		 processed = ProcessAllPendingTrim();

		if (processed > 0)
		{
			DFTL_IncreaseProfile(Prof_DS_GC_Times);
			DFTL_IncreaseProfile(Prof_DS_Discared_Pages, processed);
		}
	}

	nFreeBlock = pstGlobal->GetSBInfoMgr()->m_nFreeCount;
	if (nFreeBlock > m_nThreshold)
	{
		DFTL_IncreaseProfile(Prof_GC_UTIL_Hit);
		DFTL_GLOBAL::GetSuperGCMgr()->loadCNT = 0;
		DFTL_GLOBAL::GetMetaMgr()->ReleaseConfinedEntries();
		return 0;
	}
	CandVBN = GetVictimVBN();
	if (CandVBN != INVALID_VBN)
	{
		if (processed > 0)
		{
			if (prevVPC > victimVPC)
			{
				DFTL_IncreaseProfile(Prof_DS_Reduced_Pages, prevVPC - victimVPC);
			}
		}
		m_nVictimVBN = CandVBN;
		if (DFTL_GLOBAL::GetInstance()->m_bEnable == 2)
		{
			xil_printf("GC START [%u] %u Loads:[%u] \r\n", m_nVictimVBN, nFreeBlock, processed);
		}
		return 1;
	}
	DFTL_GLOBAL::GetSuperGCMgr()->loadCNT = 0;
	return 0;
}

VOID 
GC_MGR::Initialize(UINT32 nGCTh, IOTYPE eIOType, UINT32 channel, UINT32 way)
{
	m_nThreshold	= nGCTh;
	m_eIOType		= eIOType;
	m_channel = channel;
	m_way = way;
	m_nVictimVBN = INVALID_VBN;
	GC_POLICY_GREEDY::Initialize(eIOType);
}

VOID
GC_MGR::Run(VOID)
{
	if (IsGCRunning() == FALSE)
	{
		return;
	}

#if (SUPPORT_META_DEMAND_LOADING == 1)
	if (m_eIOType == IOTYPE_GC)
	{
		if (DFTL_GLOBAL::GetInstance()->isMetaGCing() == TRUE)
		{
			return;
		}
	}
#endif

	_Read();
}

BOOL
GC_MGR::IsGCRunning(VOID)
{
	if (m_nVictimVBN == INVALID_VBN)
	{
		return FALSE;
	}

	return TRUE;
}

UINT32
GC_MGR::CheckAndStartGC(VOID)
{
	if (m_eIOType == IOTYPE_META)
	{
		if (IsGCRunning() == TRUE)
		{
			return 0;
		}
	}

	UINT32 nFreeBlock;
	DFTL_GLOBAL*	pstGlobal = DFTL_GLOBAL::GetInstance();

	nFreeBlock = m_pstBlockMgr->GetFreeBlockCount(m_channel, m_way);

	if (m_eIOType == IOTYPE_META)
	{
		if (nFreeBlock > m_nThreshold)
		{
			return 0;
		}
	}

	if (m_eIOType == IOTYPE_META)
	{
		m_nVictimVBN = GetVictimVBN(m_channel, m_way);
	}
	else
	{
		UINT32 cand_victim = pstGlobal->GetSuperGCMgr()->m_nVictimVBN;
		if (DFTL_GLOBAL::GetVBInfoMgr(m_channel, m_way)->GetVBInfo(cand_victim)->IsFree())
			return 0;
		pstGlobal->GetSuperGCMgr()->m_nGCCnt += 1;
		m_nVictimVBN = cand_victim;
	}

	m_nVPC = pstGlobal->GetVPagePerVBlock() - DFTL_GLOBAL::GetVBInfoMgr(m_channel, m_way)->GetVBInfo(m_nVictimVBN)->GetInvalidLPNCount();
	m_nVCNT = DFTL_GLOBAL::GetVBInfoMgr(m_channel, m_way)->GetVBInfo(m_nVictimVBN)->GetValidLPNCount();
	m_nCurReadVPageOffset = 0;
	m_nWriteCount = 0;
	m_nIssuedCount = 0;

	if (m_eIOType != IOTYPE_META)
	{
		if (DFTL_GLOBAL::GetInstance()->m_bEnable == 2)
		{
			xil_printf("GC START VBN[%u] CH[%u] WY[%u] PageCnt[%u]\r\n", m_nVictimVBN, m_channel, m_way, m_nVPC);
		}
	}
	if (m_eIOType == IOTYPE_META) {
		DFTL_GLOBAL::GetInstance()->SetMetaGCing();
		DFTL_IncreaseProfile(Prof_CMTGC_count);
	}
	else {
		DFTL_IncreaseProfile(Prof_GC_count);
	}

#if (SUPPORT_GC_DEBUG == 1)
	m_stDebug.Initialize();
#endif

#if (SUPPORT_BLOCK_DEBUG == 1)
	m_pstBlockMgr->CheckVPC(m_channel, m_way, m_nVictimVBN);
#endif

	return 1;
}

VOID
GC_MGR::IncreaseWriteCount(VOID)
{
	m_nWriteCount++;

	if (m_eIOType == IOTYPE_META) {
		DFTL_IncreaseProfile(Prof_CMTGC_write);
	}
	else {
		DFTL_IncreaseProfile(Prof_GC_write);
	}

	DEBUG_ASSERT(m_nWriteCount <= m_nVPC);

	if (m_nWriteCount == m_nVPC)
	{
		UINT32 pastVBN = m_nVictimVBN;
		m_nVictimVBN = INVALID_VBN;
#if (SUPPORT_META_DEMAND_LOADING == 1)
		if (m_eIOType == IOTYPE_META) {
			BOOL	Meta_GCing = FALSE;
			for (UINT32 channel = 0; channel < USER_CHANNELS; channel++) {
				for (UINT32 way = 0; way < USER_WAYS; way++) {
					if (DFTL_GLOBAL::GetMetaGCMgr(channel, way)->IsGCRunning() == TRUE) {
						Meta_GCing = TRUE;
					}
				}
			}
			if(Meta_GCing == FALSE)
				DFTL_GLOBAL::GetInstance()->ClearMetaGCing();
		}
		else
		{
			if (DFTL_GLOBAL::GetVBInfoMgr(m_channel, m_way)->GetVBInfo(pastVBN)->IsFree() != TRUE)
			{
				DFTL_GLOBAL::GetInstance()->GetUserBlockMgr()->Release(m_channel, m_way, pastVBN, 1);
			}

			DFTL_GLOBAL::GetSuperGCMgr()->m_nGCCnt -= 1;
			if (DFTL_GLOBAL::GetSuperGCMgr()->m_nGCCnt == 0)
			{
				DFTL_GLOBAL::GetSuperGCMgr()->m_nVictimVBN = INVALID_VBN;

				if (DFTL_GLOBAL::GetInstance()->m_bEnable == 2)
				{
					xil_printf("[GC END'2] VBN:%u, CH%u, WY:%u(%d USED), FREE:%u\r\n", pastVBN, m_channel, m_way,
							DFTL_GLOBAL::GetSBInfoMgr()->m_pastSBInfo[pastVBN].m_nUSED,
							DFTL_GLOBAL::GetSBInfoMgr()->m_nFreeCount);
				}

				DFTL_GLOBAL::GetMetaMgr()->ReleaseConfinedEntries();
				if (DFTL_GLOBAL::GetSuperGCMgr()->loadCNT != 0)
				{
					DFTL_GLOBAL::GetSuperGCMgr()->loadCNT = 0;
				}
			}
		}
#endif
	}
}

VOID
GC_MGR::IncreaseIssuedCount(VOID)
{
	m_nIssuedCount++;
	DEBUG_ASSERT(m_nIssuedCount <= m_nVPC);
}

VOID
GC_MGR::_Read(VOID)
{
	DFTL_GLOBAL*	pstGlobal = DFTL_GLOBAL::GetInstance();
	VNAND*			pstVNand = pstGlobal->GetVNandMgr();

	// 체크: 이미 Issue와 Write 카운트가 어긋나 있다면(이전 요청 처리 중) 리턴
	if (m_nIssuedCount != m_nWriteCount && m_nIssuedCount != m_nWriteCount + 1) {
		return;
	}

	do
	{
		// 1. 블록 끝까지 다 읽었는지 확인
		if (m_nCurReadVPageOffset >= pstGlobal->GetVPagePerVBlock())
		{
			if (m_eIOType != IOTYPE_META)
			{
				if (m_nWriteCount == m_nIssuedCount)
				{
					// 모든 페이지 처리 완료 -> 블록 해제
					if (DFTL_GLOBAL::GetVBInfoMgr(m_channel, m_way)->GetVBInfo(m_nVictimVBN)->IsFree() != TRUE)
					{
						DFTL_GLOBAL::GetInstance()->GetUserBlockMgr()->Release(m_channel, m_way, m_nVictimVBN, 1);
					}

					DFTL_GLOBAL::GetSuperGCMgr()->m_nGCCnt -= 1;
					if (DFTL_GLOBAL::GetSuperGCMgr()->m_nGCCnt == 0)
					{
						DFTL_GLOBAL::GetSuperGCMgr()->m_nVictimVBN = INVALID_VBN;
						if (DFTL_GLOBAL::GetInstance()->m_bEnable == 2)
						{
							xil_printf("[GC END'1] VBN:%u, CH%u, WY:%u(%d USED), FREE:%u\r\n", m_nVictimVBN, m_channel, m_way,
									DFTL_GLOBAL::GetSBInfoMgr()->m_pastSBInfo[m_nVictimVBN].m_nUSED,
									DFTL_GLOBAL::GetSBInfoMgr()->m_nFreeCount);
						}
						if (DFTL_GLOBAL::GetSuperGCMgr()->loadCNT != 0)
						{
							DFTL_GLOBAL::GetSuperGCMgr()->loadCNT = 0;
						}
						DFTL_GLOBAL::GetMetaMgr()->ReleaseConfinedEntries();
					}
					m_nVictimVBN = INVALID_VBN;
				}
				else
				{
					if (m_nVPC != m_nIssuedCount)
					{
						m_nVPC = m_nIssuedCount;
					}
				}
			}
			return;
		}

		// 2. 현재 페이지가 Valid한지 확인
		BOOL bValid = pstVNand->IsValid(m_channel, m_way, m_nVictimVBN, m_nCurReadVPageOffset);

		if (bValid == TRUE)
		{
			break; // Valid Page -> Read Request
		}
		m_nCurReadVPageOffset++;

		DEBUG_ASSERT(m_nCurReadVPageOffset <= pstGlobal->GetVPagePerVBlock());
	} while (1);

	// 실제 Read 요청 발행
	REQUEST_MGR*	pstReqMgr = pstGlobal->GetRequestMgr();
	GC_REQUEST*	pstRequest;

	pstRequest = pstReqMgr->AllocateGCRequest();
	if (pstRequest == NULL)
	{
		return;
	}

	UINT32	nVPPN = VPPN_FROM_VBN_VPN(m_channel, m_way, m_nVictimVBN, m_nCurReadVPageOffset);

	pstRequest->Initialize(GC_REQUEST_READ_WAIT, nVPPN, m_eIOType);

	pstReqMgr->AddToGCRequestWaitQ(pstRequest);

	m_nCurReadVPageOffset++;
	IncreaseIssuedCount();

	if (m_nCurReadVPageOffset >= pstGlobal->GetVPagePerVBlock())
		if (m_eIOType != IOTYPE_META)
			m_nVPC = m_nIssuedCount;

	if (m_eIOType == IOTYPE_META) {
		DFTL_IncreaseProfile(Prof_CMTGC_read);
	}
	else {
		DFTL_IncreaseProfile(Prof_GC_read);
	}
	return;
}

VOID 
GC_POLICY_GREEDY::Initialize(IOTYPE eIOType)
{
	switch (eIOType)
	{
	case IOTYPE_GC:
		m_pstBlockMgr = DFTL_GLOBAL::GetUserBlockMgr();
		break;

#if (SUPPORT_META_DEMAND_LOADING == 1)
	case IOTYPE_META:
		m_pstBlockMgr = DFTL_GLOBAL::GetMetaBlockMgr();
		break;
#endif

	default:
		ASSERT(0);
		break;
	}
}

UINT32
GC_POLICY_GREEDY::GetVictimVBN(UINT32 channel, UINT32 way)
{
	VBINFO*	pstVBInfo;
	UINT32	nVictimVBN = INVALID_VBN;
	UINT32	nMaxInvalid = 0;

	list_for_each_entry(VBINFO, pstVBInfo, &m_pstBlockMgr->m_dlUsedBlocks[channel][way], m_dlList)
	{
		DEBUG_ASSERT(pstVBInfo->IsFree() == FALSE);

		if (pstVBInfo->IsActive() == TRUE)
		{
			continue;
		}

		if (pstVBInfo->GetInvalidLPNCount() > nMaxInvalid)
		{
			nMaxInvalid	= pstVBInfo->GetInvalidLPNCount();
			nVictimVBN	= pstVBInfo->m_nVBN;
		}
	}

	DEBUG_ASSERT(nVictimVBN != INVALID_VBN);
	DFTL_GLOBAL::GetInstance()->IncreaseProfileCount(PROFILE_BGC);
	return nVictimVBN;
}

VOID
GC_DEBUG::Initialize(VOID)
{
	INT32 nSize;
	nSize = DFTL_GLOBAL::GetInstance()->GetVPagePerVBlock() * sizeof(GC_DEBUG_FLAG);

	if (m_apstVPNStatus == NULL)
	{
		m_apstVPNStatus = static_cast<GC_DEBUG_FLAG*>(OSAL_MemAlloc(MEM_TYPE_FW_DATA, nSize, OSAL_MEMALLOC_FW_ALIGNMENT));
	}

	OSAL_MEMSET(m_apstVPNStatus, 0x00, nSize);
	m_nRead = 0;
	m_nWrite = 0;
}

VOID
GC_DEBUG::SetFlag(UINT32 nVPPN, GC_DEBUG_FLAG eFlag)
{
	UINT32 modVPPN = CHANNEL_VPPN(nVPPN);
	UINT32 nVPageOffset = VPN_FROM_VPPN(modVPPN);
	UINT32 channel = CHANNEL_FROM_VPPN(nVPPN);
	UINT32 way = WAY_FROM_VPPN(nVPPN);

	DEBUG_ASSERT((m_apstVPNStatus[nVPageOffset] & eFlag) == 0);

	m_apstVPNStatus[nVPageOffset] = static_cast<GC_DEBUG_FLAG>((UINT32)m_apstVPNStatus[nVPageOffset] | (UINT32)eFlag);

	switch (eFlag)
	{
	case GC_DEBUG_FLAG_READ:
		m_nRead++;
		break;

	case GC_DEBUG_FLAG_WRITE_ISSUE:
		m_nWrite++;
		break;

	case GC_DEBUG_FLAG_WRITE_DONE:
		DEBUG_ASSERT(m_apstVPNStatus[nVPageOffset] == GC_DEBUG_FLAG_MASK);
		break;
	}
}
